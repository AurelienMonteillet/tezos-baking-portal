# AWS Credentials Configuration
# Copy this file to .aws-credentials (not committed to Git)
# Or use AWS CLI profiles: aws configure --profile staging

# STAGING Credentials
export AWS_ACCESS_KEY_ID_STAGING="AKIAZVZBOPN54WIRZGWN"
export AWS_SECRET_ACCESS_KEY_STAGING="<your-staging-secret-key>"

# PRODUCTION Credentials
export AWS_ACCESS_KEY_ID_PROD="AKIAZVZBOPN5T77KQ3C3"
export AWS_SECRET_ACCESS_KEY_PROD="<your-prod-secret-key>"

# Default region
export AWS_DEFAULT_REGION="us-east-1"

